# ─── EPA BOTCHI ─────────────────────────────────────────────────────────────
# Copia para .env e preenche. O bot é privado: só funciona nos servidores daqui.

# Token do bot (Discord Developer Portal → Bot → Reset Token)
BOT_TOKEN=
# Application ID (opcional)
CLIENT_ID=

# PostgreSQL. Neon/Supabase: o TLS é verificado automaticamente.
# Docker (docker-compose.yml): postgres://epa:epa@postgres:5432/epa?sslmode=disable
DATABASE_URL=postgres://utilizador:password@host:5432/base_de_dados
# PGSSLMODE=no-verify    # só para diagnóstico, nunca em produção

# Servidor principal (os comandos são registados aqui na hora)
GUILD_ID=
# Outros servidores onde o bot também funciona (ex.: o de testes), separados por vírgulas
EXTRA_GUILD_IDS=
# Contas com acesso total ao /config e aos comandos de administração, separadas por vírgulas
OWNER_IDS=

# Opcional
# WEBHOOK_LOGS_URL=
# LOG_LEVEL=debug

# ─── Alertas sociais (opcional) ─────────────────────────────────────────────
# YouTube e TikTok funcionam sem chaves. Twitch: dev.twitch.tv/console.
# Kick: kick.com/settings/developer (client credentials).
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
